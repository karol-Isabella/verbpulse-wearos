<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Card Badge for safe-zone visual balance on both circular & square screens -->
    <path
        android:fillColor="#1C1C20"
        android:pathData="M 42,28 L 66,28 A 14,14 0 0,1 80,42 L 80,66 A 14,14 0 0,1 66,80 L 42,80 A 14,14 0 0,1 28,66 L 28,42 A 14,14 0 0,1 42,28 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#33FF5216" />

    <!-- Stylized VerbPulse Wave (V letter + pulse spike) -->
    <path
        android:pathData="M 36,44 L 46,65 L 53,38 L 61,68 L 68,51 L 72,51"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="36"
                android:startY="38"
                android:endX="72"
                android:endY="68"
                android:type="linear">
                <item
                    android:color="#FFFF8A50"
                    android:offset="0.0" />
                <item
                    android:color="#FFFF5216"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Accent Energy / Streak Sparkle Dot -->
    <path
        android:fillColor="#FFFF8A50"
        android:pathData="M 68,38 a 3.5,3.5 0 1,0 7,0 a 3.5,3.5 0 1,0 -7,0" />
</vector>